# SubTracker Environment Configuration
COMPOSE_PROJECT_NAME=subtracker
ENVIRONMENT=production
POSTGRES_USER=appuser
POSTGRES_PASSWORD=SubTrackerSecurePassword2026!
POSTGRES_DB=appdb
DATABASE_URL=postgresql://appuser:SubTrackerSecurePassword2026!@db:5432/appdb
SECRET_KEY=subtracker-super-secret-jwt-key-2026

# Container Image & Versioning (e.g. from ECR: 123456789.dkr.ecr.us-east-1.amazonaws.com/subtracker:20261116-120000-abc1234)
APP_IMAGE=subtracker:latest

# OpenTelemetry Observability (exports metrics, traces, and structured logs over OTLP)
OTEL_SERVICE_NAME=subtracker-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Alerting & On-Call Responder Webhook
ONCALL_WEBHOOK_URL=http://host.docker.internal:8080/alerts
