# SubTracker Database Configuration
# Primary: PostgreSQL (production & docker-compose)
# Fallback: SQLite (local development tests)
# Examples:
#   PostgreSQL (primary):
#     DATABASE_URL=postgresql://user:password@localhost:5432/appdb
#   SQLite (local development test fallback):
#     DATABASE_URL=sqlite:///./app.db

DATABASE_URL=postgresql://user:password@localhost:5432/appdb

# Authentication Security
SECRET_KEY=subtracker-super-secret-jwt-key-2026
