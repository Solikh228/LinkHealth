# SubTracker Database Configuration
# Database-agnostic: supports SQLite, PostgreSQL, MySQL, etc.
# Examples:
#   SQLite (default):
#     DATABASE_URL=sqlite:///./subtracker.db
#   PostgreSQL:
#     DATABASE_URL=postgresql://user:password@localhost:5432/subtracker
#   MySQL:
#     DATABASE_URL=mysql+pymysql://user:password@localhost:3306/subtracker

DATABASE_URL=sqlite:///./subtracker.db

# Authentication Security
SECRET_KEY=subtracker-super-secret-jwt-key-2026
