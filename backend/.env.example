# SubTracker Database Configuration
# Primary: PostgreSQL (production & docker-compose)
# Fallback: SQLite (local development tests)
DATABASE_URL=postgresql://user:password@localhost:5432/appdb

# Authentication Security
SECRET_KEY=subtracker-super-secret-jwt-key-2026

# Application Environment & Image Tag
ENVIRONMENT=dev
APP_IMAGE=subtracker-backend:latest

# OpenTelemetry Observability Configuration
OTEL_SERVICE_NAME=subtracker-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
