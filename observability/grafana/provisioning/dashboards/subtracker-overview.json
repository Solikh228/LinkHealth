  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SubTracker Service Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-subtracker"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-subtracker" },
          "editorMode": "code",
          "expr": "sum(rate(subtracker_http_server_duration_milliseconds_count[1m])) by (http_route, http_status_code)",
          "legendFormat": "{{http_route}} [{{http_status_code}}]",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate by Route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-subtracker"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-subtracker" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(subtracker_http_server_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-subtracker" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(subtracker_http_server_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "HTTP Request Latency (p50 / p95)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Logs & Traces Correlation",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki-subtracker"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-subtracker" },
          "editorMode": "code",
          "expr": "{service_name=~\"subtracker.*\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Live Structured Logs (Loki)",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["subtracker", "opentelemetry", "fastapi"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus-subtracker" },
        "definition": "label_values(deployment_environment_name)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "environment",
        "query": { "query": "label_values(deployment_environment_name)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "SubTracker - OpenTelemetry Observability",
  "uid": "subtracker-otel-overview",
  "version": 1
}
